# Copiez ce fichier en .env et renseignez vos identifiants réels.
# Ces variables ont PRIORITÉ sur config/affiliation.json.
# Ne jamais committer le fichier .env (il est dans .gitignore).

# Amazon Partenaires (https://partenaires.amazon.fr) — votre tag de suivi
# Laissez la valeur REMPLACER-21 tant que vous n'avez pas votre vrai tag (ex. culturasab-21).
AMAZON_PARTNER_TAG=REMPLACER-21

# Awin (https://www.awin.com) — votre identifiant éditeur
AWIN_AFFILIATE_ID=000000

# Base URL du site (utilisée pour les liens canoniques / UTM)
SITE_BASE_URL=https://www.culturasabauda.eu

# Traceur de clics pour les PARTENAIRES LOCAUX (= URL publique du tableau de bord).
# Les liens "local" passeront par <base>/go (compte le clic puis redirige).
# Laisser vide pour des liens directs sans comptage.
TRACKER_BASE_URL=https://dashboard.culturasabauda.eu

# --- Publication WordPress (src/publish-wordpress.mjs) ---
# Mot de passe d'application WordPress : Réglages → Utilisateurs → Mot de passe d'application
WP_BASE_URL=https://www.culturasabauda.eu
WP_USER=mon_login
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Rédaction assistée par Claude (src/ai/draft-guide.mjs) ---
# Nécessite aussi : npm i @anthropic-ai/sdk
ANTHROPIC_API_KEY=sk-ant-...
