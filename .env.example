# Copiez ce fichier en .env et renseignez vos identifiants réels.
# Ces variables ont PRIORITÉ sur config/affiliation.json.
# Ne jamais committer le fichier .env (il est dans .gitignore).

# Amazon Partenaires (https://partenaires.amazon.fr) — votre tag de suivi
AMAZON_PARTNER_TAG=monidentifiant-21

# Awin (https://www.awin.com) — votre identifiant éditeur
AWIN_AFFILIATE_ID=000000

# Base URL du site (utilisée pour les liens canoniques / UTM)
SITE_BASE_URL=https://www.culturasabauda.eu
